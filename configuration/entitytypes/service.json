{
  "name": "service",
  "schema": {
    "type": "object",
    "required": [
      "ip_address",
      "port",
      "protocol"
    ],
    "properties": {
      "ip_address": {
        "type": "string",
        "description": "IPv4 or IPv6 address"
      },
      "port": {
        "type": "number"
      },
      "protocol": {
        "enum": [
          "tcp",
          "udp"
        ],
        "type": "string"
      },
      "service": {
        "type": "string",
        "description": "Discovered service"
      },
      "info": {
        "type": "string",
        "description": "More information about discovered service"
      }
    }
  },
  "identifier_keys": "ip_address,port,protocol",
  "approval_required": false
}
