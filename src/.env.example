# If you run the tool directly without our container,
# copy this file to .env and adjust as needed
#
# If you use the container, adjust the config in deployment/.env

# SECRET_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1

# POSTGRES_DB=squiggle
# POSTGRES_USER=squiggle
# POSTGRES_PASSWORD=password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# RABBITMQ_USER=squiggle
# RABBITMQ_PASSWORD=password
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_VHOST=squiggle

# ARTIFACTS_DIR=files/artifacts
# TMP_DIR=files/tmp

# TIME_ZONE=Europe/Berlin

# when we run everything in docker, we internally work with paths that are valid inside the container
# however, starting a new container required the real path on the host
# ARTIFACTS/TMP_DIR_HOST_OVERRIDE override the ARTIFACTS/TMP_DIR configs for such operations
# For example, ARTIFACTS_DIR could be /data/artifacts (default value in container),
# but ARTIFACTS_DIR_HOST_OVERRIDE could /home/user/data/artifacts
# ARTIFACTS_DIR_HOST_OVERRIDE="data/artifacts"
# TMP_DIR_HOST_OVERRIDE="data/tmp"
