# change the secret key (from Django framework)
SECRET_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# credentials for db
# the password is set once during the first postgresql start
# if you change the password later, you have to change it manually in the db (and here for the app)
POSTGRES_DB=squiggle
POSTGRES_USER=squiggle
POSTGRES_PASSWORD=password

# credentials for rabbitmq
RABBITMQ_USER=squiggle
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=squiggle

# the timezone used in the web app
TIME_ZONE=Europe/Berlin
